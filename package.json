{
  "name": "lockin",
  "private": true,
  "version": "1.3.0",
  "description": "LockIn — finish what matters before distractions take over.",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "install:web": "npm --prefix web install",
    "//release": "Phase 8. Origins come from lockin.config.json; a production build needs LOCKIN_ENV=production LOCKIN_APP_ORIGIN=https://your.origin",
    "config:extension": "node scripts/gen-extension-config.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "package:extension": "node scripts/build-extension.mjs --zip",
    "build:release": "npm run build && npm run package:extension",
    "test": "npm run test:logic && npm run test:reminders && npm run test:bridge && npm run test:canvas-logic && npm run test:edgenuity-logic && npm run test:edgenuity-state && npm run test:edgenuity-screen && npm run test:parent-selectors && npm run test:parent-state && npm run test:planner-logic && npm run test:planner-state && npm run test:storage && npm run test:security && npm run test:time && npm run test:release && npm run test:perf && npm run test:phase9 && npm run test:pace && npm run test:canvas-ics && npm run test:edgenuity-import && npm run test:companion && npm run test:context-bridge && npm run test:phase16",
    "test:logic": "node --test extension/tests/blocking.test.mjs",
    "test:reminders": "node --test extension/tests/reminders.test.mjs",
    "test:bridge": "node --test extension/tests/bridge.test.mjs",
    "test:canvas-logic": "node --test extension/tests/canvas-logic.test.mjs",
    "test:parser": "node extension/tests/canvas-parser.test.mjs",
    "test:e2e": "node extension/tests/e2e.mjs",
    "test:e2e:headful": "node extension/tests/e2e.mjs --headful",
    "test:canvas-e2e": "node extension/tests/canvas-e2e.mjs",
    "//edgenuity": "Phase 4. The logic and state suites import the website's TypeScript directly (see extension/tests/ts-resolve.mjs).",
    "test:edgenuity-logic": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/edgenuity-logic.test.mjs",
    "test:edgenuity-state": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/edgenuity-state.test.mjs",
    "test:edgenuity-ocr": "node --import ./extension/tests/ts-resolve.mjs extension/tests/edgenuity-ocr.test.mjs",
    "test:edgenuity-e2e": "node extension/tests/edgenuity-e2e.mjs",
    "test:edgenuity-e2e:headful": "node extension/tests/edgenuity-e2e.mjs --headful --verbose",
    "//enhanced": "Phase 5. Enhanced Proof: one-time challenge codes.",
    "test:edgenuity-screen": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/edgenuity-screen.test.mjs",
    "//parent": "Phase 6. Parent Dashboard: selectors, state and the enforcement E2E.",
    "test:parent-selectors": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/parent-selectors.test.mjs",
    "test:parent-state": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/parent-state.test.mjs",
    "test:parent-e2e": "node extension/tests/parent-e2e.mjs",
    "test:parent-e2e:headful": "node extension/tests/parent-e2e.mjs --headful --verbose",
    "//planner": "Phase 7. Smart Study Planner: the pure engine, the store, and the real-browser flow.",
    "test:planner-logic": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/planner-logic.test.mjs",
    "test:planner-state": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/planner-state.test.mjs",
    "test:planner-e2e": "node extension/tests/planner-e2e.mjs",
    "test:planner-e2e:headful": "node extension/tests/planner-e2e.mjs --headful --verbose",
    "fixtures:edgenuity": "node extension/tests/edgenuity-fixtures.mjs",
    "typecheck": "npm --prefix web run build",
    "test:all": "npm run build && npm run test && npm run test:parser && npm run test:e2e && npm run test:canvas-e2e && npm run test:edgenuity-ocr && npm run test:edgenuity-e2e && npm run test:parent-e2e && npm run test:planner-e2e && npm run test:release-e2e && npm run test:a11y-e2e",
    "//phase8": "Phase 8. Release safety, storage recovery, security and time boundaries.",
    "test:release": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/release.test.mjs",
    "test:storage": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/storage-recovery.test.mjs",
    "test:security": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/security.test.mjs",
    "test:time": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/time-boundaries.test.mjs",
    "test:release-e2e": "node extension/tests/release-e2e.mjs",
    "test:release-e2e:headful": "node extension/tests/release-e2e.mjs --headful",
    "test:perf": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/performance.test.mjs",
    "test:a11y-e2e": "node extension/tests/a11y-e2e.mjs",
    "test:a11y-e2e:headful": "node extension/tests/a11y-e2e.mjs --headful",
    "//phase16": "Phase 16. Provenance, the Pace Engine, Canvas ICS and the Edgenuity report/email adapters.",
    "test:canvas-ics": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/canvas-ics.test.mjs",
    "test:edgenuity-import": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/edgenuity-import.test.mjs",
    "test:companion": "node --test extension/tests/companion.test.mjs",
    "test:context-bridge": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/context-bridge.test.mjs",
    "test:phase16": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/phase16-state.test.mjs",
    "test:phase16": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/phase16-state.test.mjs",
    "test:pace": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/pace.test.mjs",
    "test:phase9": "node --import ./extension/tests/ts-resolve.mjs --test extension/tests/phase9.test.mjs",
    "serve": "node scripts/serve.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "service:status": "node scripts/service.mjs status",
    "service:restart": "node scripts/service.mjs restart"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
