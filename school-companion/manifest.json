{
  "manifest_version": 3,
  "name": "LockIn School Companion",
  "version": "1.3.0",
  "description": "Tells LockIn whether Canvas or Edgenuity is open, and nothing else. Optional, and only for use where your organization allows it.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "options.html",
    "default_title": "LockIn School Companion",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
